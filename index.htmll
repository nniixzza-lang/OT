<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OT 記錄神器</title>
    <!-- 引入 Tailwind CSS 方便排版 -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Tesseract.js 做圖片文字識別 -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
</head>
<body class="bg-gray-100 p-4 font-sans max-w-md mx-auto">

    <h1 class="text-2xl font-bold text-center mb-6 text-gray-800">🕒 OT 記錄神器</h1>

    <!-- 統計面板 -->
    <div class="bg-white p-4 rounded-lg shadow-md mb-6 border-l-4 border-blue-500">
        <h2 class="font-bold text-lg mb-2 text-gray-700">📊 數據統計</h2>
        <p class="text-sm text-gray-600">本週 OT：<span id="weekTotal" class="font-bold text-blue-600">0</span> 日 ($<span id="weekMoney">0</span>)</p>
        <p class="text-sm text-gray-600 mt-1">本月 OT：<span id="monthTotal" class="font-bold text-blue-600">0</span> 日 ($<span id="monthMoney">0</span>)</p>
        <hr class="my-2">
        <p class="text-sm text-red-600 font-bold">⚠️ 尚未收到：$<span id="unpaidTotal">0</span></p>
    </div>

    <!-- 新增記錄表單 -->
    <div class="bg-white p-4 rounded-lg shadow-md mb-6">
        <h2 class="font-bold text-lg mb-4 text-gray-700">➕ 新增 OT 記錄</h2>
        
        <label class="block text-sm font-medium text-gray-700 mb-1">上傳打卡相片</label>
        <input type="file" accept="image/*" id="imageInput" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 mb-4"/>
        
        <div id="loadingMsg" class="hidden text-sm text-blue-600 mb-4 animate-pulse">正在識別圖片中的日期及時間，請稍候...</div>
        <img id="preview" class="hidden w-full h-auto rounded mb-4 max-h-48 object-contain bg-gray-50 border">

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">日期</label>
                <input type="date" id="dateInput" class="w-full border-gray-300 rounded-md border p-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">時間</label>
                <input type="time" id="timeInput" class="w-full border-gray-300 rounded-md border p-2 text-sm">
            </div>
        </div>
        <button id="saveBtn" class="w-full bg-blue-600 text-white py-2 rounded-md font-bold hover:bg-blue-700 transition">儲存記錄</button>
    </div>

    <!-- 記錄列表 -->
    <div class="bg-white p-4 rounded-lg shadow-md">
        <h2 class="font-bold text-lg mb-4 text-gray-700">📝 歷史記錄</h2>
        <div id="recordList" class="space-y-4"></div>
    </div>

    <script>
        const OT_RATE = 100; // 每日 OT 補水 100 蚊
        let records = JSON.parse(localStorage.getItem('ot_records')) || [];
        let currentCompressedImage = '';

        // 初始化
        updateUI();

        // 監聽圖片上傳
        document.getElementById('imageInput').addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (!file) return;

            // 顯示載入中及圖片預覽
            document.getElementById('loadingMsg').classList.remove('hidden');
            const preview = document.getElementById('preview');
            
            // 壓縮圖片 (避免 localStorage 爆滿)
            currentCompressedImage = await compressImage(file);
            preview.src = currentCompressedImage;
            preview.classList.remove('hidden');

            // 使用 Tesseract.js 進行 OCR
            try {
                const result = await Tesseract.recognize(currentCompressedImage, 'eng');
                const text = result.data.text;
                
                // 嘗試用 Regex 捕捉日期 (YYYY-MM-DD 或 YYYY/MM/DD) 及時間 (HH:MM)
                const dateMatch = text.match(/(\d{4}[-/]\d{1,2}[-/]\d{1,2})/);
                const timeMatch = text.match(/(\d{1,2}:\d{2})/);
                
                if (dateMatch) {
                    let d = new Date(dateMatch[0].replace(/\//g, '-'));
                    if(!isNaN(d)) document.getElementById('dateInput').value = d.toISOString().split('T')[0];
                }
                if (timeMatch) document.getElementById('timeInput').value = timeMatch[0];
                
            } catch (error) {
                console.error("OCR 失敗", error);
            } finally {
                document.getElementById('loadingMsg').classList.add('hidden');
            }
        });

        // 儲存記錄
        document.getElementById('saveBtn').addEventListener('click', () => {
            const date = document.getElementById('dateInput').value;
            const time = document.getElementById('timeInput').value;

            if (!date) {
                alert("請填寫日期！");
                return;
            }

            const newRecord = {
                id: Date.now().toString(),
                date: date,
                time: time,
                image: currentCompressedImage,
                isPaid: false
            };

            records.push(newRecord);
            records.sort((a, b) => new Date(b.date) - new Date(a.date)); // 日期由新至舊排序
            saveData();
            
            // 清空表單
            document.getElementById('imageInput').value = '';
            document.getElementById('dateInput').value = '';
            document.getElementById('timeInput').value = '';
            document.getElementById('preview').classList.add('hidden');
            currentCompressedImage = '';
        });

        // 切換付款狀態
        function toggleStatus(id) {
            const record = records.find(r => r.id === id);
            if (record) {
                record.isPaid = !record.isPaid;
                saveData();
            }
        }

        // 刪除記錄
        function deleteRecord(id) {
            if(confirm("確定要刪除這條記錄嗎？")) {
                records = records.filter(r => r.id !== id);
                saveData();
            }
        }

        // 儲存並更新 UI
        function saveData() {
            try {
                localStorage.setItem('ot_records', JSON.stringify(records));
                updateUI();
            } catch (e) {
                alert("儲存空間已滿！請先刪除部分舊記錄。");
            }
        }

        // 更新畫面與計算統計
        function updateUI() {
            const listDiv = document.getElementById('recordList');
            listDiv.innerHTML = '';

            const now = new Date();
            const startOfWeek = new Date(now.setDate(now.getDate() - now.getDay() + 1));
            startOfWeek.setHours(0,0,0,0);
            const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

            let weekDays = 0, monthDays = 0, unpaidAmount = 0;

            records.forEach(r => {
                const rDate = new Date(r.date);
                
                // 統計計算
                if (rDate.getFullYear() === startOfMonth.getFullYear() && rDate.getMonth() === startOfMonth.getMonth()) {
                    monthDays++;
                }
                if (rDate >= startOfWeek) {
                    weekDays++;
                }
                if (!r.isPaid) {
                    unpaidAmount += OT_RATE;
                }

                // 建立列表項目
                const div = document.createElement('div');
                div.className = `p-3 rounded-lg border ${r.isPaid ? 'bg-green-50 border-green-200' : 'bg-red-50 border-red-200'} flex gap-3`;
                
                const imgHtml = r.image ? `<img src="${r.image}" class="w-20 h-20 object-cover rounded shadow-sm">` : `<div class="w-20 h-20 bg-gray-200 flex items-center justify-center text-xs text-gray-500 rounded">無圖</div>`;
                
                div.innerHTML = `
                    ${imgHtml}
                    <div class="flex-1 flex flex-col justify-between">
                        <div>
                            <p class="font-bold text-gray-800">${r.date} <span class="text-sm font-normal text-gray-500">${r.time || ''}</span></p>
                            <p class="text-sm font-medium ${r.isPaid ? 'text-green-600' : 'text-red-600'}">
                                ${r.isPaid ? '✅ 已收 $100' : '⏳ 未收 $100'}
                            </p>
                        </div>
                        <div class="flex gap-2 text-xs">
                            <button onclick="toggleStatus('${r.id}')" class="px-2 py-1 rounded bg-white shadow border font-medium ${r.isPaid ? 'text-orange-600 hover:bg-orange-50' : 'text-green-600 hover:bg-green-50'}">
                                ${r.isPaid ? '改為未收' : '標記已收'}
                            </button>
                            <button onclick="deleteRecord('${r.id}')" class="px-2 py-1 rounded bg-gray-100 text-gray-600 shadow border hover:bg-red-100 hover:text-red-600">
                                刪除
                            </button>
                        </div>
                    </div>
                `;
                listDiv.appendChild(div);
            });

            // 更新數字
            document.getElementById('weekTotal').innerText = weekDays;
            document.getElementById('weekMoney').innerText = weekDays * OT_RATE;
            document.getElementById('monthTotal').innerText = monthDays;
            document.getElementById('monthMoney').innerText = monthDays * OT_RATE;
            document.getElementById('unpaidTotal').innerText = unpaidAmount;
        }

        // 圖片壓縮函數 (Canvas)
        function compressImage(file) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = (event) => {
                    const img = new Image();
                    img.src = event.target.result;
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const MAX_WIDTH = 800; // 限制最大寬度
                        let width = img.width, height = img.height;
                        if (width > MAX_WIDTH) {
                            height *= MAX_WIDTH / width;
                            width = MAX_WIDTH;
                        }
                        canvas.width = width; canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);
                        resolve(canvas.toDataURL('image/jpeg', 0.7)); // 壓縮為 70% 質量的 JPEG
                    }
                }
            });
        }
    </script>
</body>
</html>
